<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>finenav_route</name>
  <version>0.1.0</version>
  <description>FineNav route graph planner and trajectory generator.</description>
  <maintainer email="wangjinghui@sjtu.edu.cn">IWIN-FINS Lab</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>libnanoflann-dev</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>finenav_core</depend>
  <depend>finenav_msgs</depend>
  <depend>finenav_util</depend>
  <depend>generate_parameter_library</depend>

  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
