Panels:
  - Class: rviz_common/Displays
    Help Height: 84
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Grid1
        - /RobotModel1
        - /TF1
        - /Path1
      Splitter Ratio: 0.5
    Tree Height: 557
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      # The grid is the only ground reference in this scene: the worlds load their
      # terrain from an external model (map_vocano.world -> model://map_vocano), which
      # Gazebo renders but rviz never sees, so apart from one 7 m frame of lidar the
      # robot would hang in empty space.
      #
      # It hangs on base_footprint rather than odom because these worlds spawn the robot
      # far out and high up: map_vocano starts 64 m from the origin and climbs to ~19 m,
      # where a 20 m wide grid pinned to odom is off screen at startup and metres
      # underfoot after the climb.  base_link would follow the robot but carries its
      # roll and pitch, so the grid would tilt with the body and cut into the terrain --
      # destroying the one thing a grid is for.  base_footprint follows the robot with
      # the tilt stripped (see BaseFootprintPublisher), so the grid stays under the
      # wheels and stays level, and a slope reads as the robot pitching against it.
      #
      # Note the .rviz files shipped with ROS all use <Fixed Frame> here.  They are flat
      # indoor scenes with the robot at the origin, where that is simply correct; none
      # covers a robot spawned 64 m out on terrain rviz cannot draw.
      #
      # The cost: a grid that follows the robot is no longer a ruler for how far it has
      # driven.  Read /path for absolute displacement, or set the view's Target Frame
      # back to <Fixed Frame>.
      Reference Frame: base_footprint
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        # With this false, frames that appear after startup are listed in the tree but
        # get no axes drawn -- which is why the TF display looked half empty, and would
        # have hidden base_footprint entirely.  The shipped examples
        # (ros_gz_sim_demos/rviz/tf_bridge.rviz, joint_states.rviz) use true; this robot
        # has ~13 frames, so there is nothing to flood.
        All Enabled: true
      Marker Scale: 0.30000001192092896
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Buffer Length: 99999
      Class: rviz_default_plugins/Path
      Color: 25; 255; 0
      Enabled: true
      Head Diameter: 0.029999999329447746
      Head Length: 0.019999999552965164
      Length: 0.029999999329447746
      Line Style: Lines
      Line Width: 0.029999999329447746
      Name: Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.009999999776482582
      Shaft Diameter: 0.009999999776482582
      Shaft Length: 0.009999999776482582
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /path
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: PointCloud2
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.009999999776482582
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /livox/lidar
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.7853981852531433
      # The camera tracks base_link so the robot is in view from startup and
      # stays there, which matters because worlds spawn the robot far from the
      # world origin (map_vocano starts 64 m out) -- an origin-anchored camera
      # would open onto empty ground.
      #
      # Fixed Frame stays odom, so the world itself does not move or tilt with
      # the robot: the grid stays level and a slope shows as the robot pitching
      # against it.  Target Frame tracks position only, not heading, so the
      # scene never spins with the robot either.
      #
      # Set this back to <Fixed Frame> in the Views panel to pin the camera to
      # the world instead -- useful for watching how far the robot has driven,
      # or for checking cloud-to-wall alignment at one fixed spot.
      Target Frame: base_link
      Value: Orbit (rviz)
      Yaw: 0.7853981852531433
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 846
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1200
  X: 60
  Y: 60
