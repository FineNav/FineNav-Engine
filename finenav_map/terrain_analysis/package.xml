<?xml version="1.0"?>
<package format="3">
    <name>finenav_map_terrain_analysis</name>
    <version>0.1.0</version>
    <description>Terrain analysis: ground detection, passability, and costmap generation from TemporalVoxelMap + OccupancyGrid2D for FineNav</description>

    <maintainer email="wangjinghui@sjtu.edu.cn">Jinghui Wang</maintainer>
    <license>MPL 2.0</license>

    <buildtool_depend>ament_cmake_auto</buildtool_depend>

    <depend>generate_parameter_library</depend>
    <depend>finenav_core</depend>
    <depend>finenav_map_grid_map</depend>
    <depend>finenav_map_temporal_voxel_map</depend>
    <depend>finenav_map_occupancy_grid_2d</depend>
    <depend>finenav_visualizer</depend>
    <depend>rclcpp</depend>
    <depend>Eigen3</depend>
    <depend>OpenCV</depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
