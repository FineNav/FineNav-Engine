<!--
  Navigate to pose with goal-reached detection.
  Uses ReactiveFallback: if IsGoalReached succeeds → tree succeeds and ComputePlan is halted.

  action_name: full path to the ControlLayer action server.
  planner_id:  must match AlgoConfigurator<T>::name of the planner loaded in the ControlLayer.
  -->
<root BTCPP_format="4">

    <!-- 主导航行为树：支持动态跟随抢占普通导航 -->
    <BehaviorTree ID="NavigateToPose">
        <ReactiveFallback name="NavigationMux">
            
            <!-- 1. 动态跟随抢占分支：如果 /target_pose 活跃且在合理区间，则持续运行，抢占其他任务 -->
            <Sequence name="DynamicFollowBranch">
                <DynamicGoalFollower topic_name="/target_pose"
                                     robot_pose="{robot_pose}"
                                     goal="{goal}"
                                     follow_distance="0.5"
                                     update_distance="0.1"
                                     min_distance="0.4"
                                     max_distance="6.0"
                                     timeout_sec="1.5">
                    <ComputePlan action_name="/hello_finenav/mppi_layer"
                                 goal="{goal}"
                                 planner_id="finenav_mppi_controller"/>
                </DynamicGoalFollower>
            </Sequence>

            <!-- 2. 普通静态点对点导航分支 -->
            <Sequence name="TrackThenStop">
                <ReactiveFallback name="NavigateOrSucceed">
                    <IsGoalReached  robot_pose="{robot_pose}"
                                    robot_twist="{robot_twist}"
                                    goal="{goal}"
                                    tolerance="0.25"
                                    speed_tolerance="0.5"/>
                    <Sequence name="RouteThenDetourThenMppi">
                        <ComputePlan action_name="/hello_finenav/route_layer"
                                     goal="{goal}"
                                     planner_id="route_planner"/>
                        <ForceSuccess>
                            <ComputePlan action_name="/hello_finenav/mppi_layer"
                                         goal="{goal}"
                                         planner_id="finenav_rotate_shim"/>
                        </ForceSuccess>
                        <!-- Detour 与 MPPI 并行运行：
                             - detour_layer (5 Hz): 周期检查全局路径是否被阻塞，若阻塞则 A* 绕障
                             - mppi_layer (10 Hz): 使用 detour_layer 输出的参考路径做轨迹优化
                             Pipeline 内部连接: route → detour → mppi
                             success_threshold=1: MPPI 到达目标时两者一起停止 -->
                        <Parallel success_threshold="1" failure_threshold="1">
                            <RetryUntilSuccessful num_attempts="-1">
                                <ComputePlan action_name="/hello_finenav/detour_layer"
                                             goal="{goal}"
                                             planner_id="detour_planner"/>
                            </RetryUntilSuccessful>
                            <RetryUntilSuccessful num_attempts="-1">
                                <ComputePlan action_name="/hello_finenav/mppi_layer"
                                             goal="{goal}"
                                             planner_id="finenav_mppi_controller"/>
                            </RetryUntilSuccessful>
                        </Parallel>
                    </Sequence>
                </ReactiveFallback>
                <!-- ReactiveFallback 返回 SUCCESS（IsGoalReached触发或MPPI到达目标）后，发布零速 -->
                <PublishZeroCmdVel  topic_name="/cmd_vel"/>
            </Sequence>
            
        </ReactiveFallback>
    </BehaviorTree>

    <!-- 独立的动态目标跟随行为树（保持不变） -->
    <BehaviorTree ID="DynamicFollowPose">
        <RetryUntilSuccessful num_attempts="-1">
            <DynamicGoalFollower topic_name="/target_pose"
                                 robot_pose="{robot_pose}"
                                 goal="{goal}"
                                 follow_distance="0.5"
                                 update_distance="0.1"
                                 min_distance="0.4"
                                 max_distance="6.0"
                                 timeout_sec="1.5">
                <ComputePlan   action_name="/hello_finenav/mppi_layer"
                               goal="{goal}"
                               planner_id="finenav_mppi_controller"/>
            </DynamicGoalFollower>
        </RetryUntilSuccessful>
    </BehaviorTree>
</root>
